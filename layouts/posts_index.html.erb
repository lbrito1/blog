<div class='pure-g h-feed'>
  <% published_posts.each do |post| %>
    <div class='post-index pure-u-1-1 h-entry'>
      <h2><a class="p-name u-url" href="<%= og_url(post) %>"><%= post[:title] %></a></h2>
      <aside class="">
        <time class="dt-published" datetime="<%= published_iso8601(post) %>"><%= post[:created_at]&.strftime('%b %d, %Y') %></time>
        <span style="display: none;"><%= author_h_card %></span> · read time: <%= reading_time_minutes(post)%> minutes
      </aside>
      <% if post[:tags] == ["book review"] %>
        <%= render('/book_review_meta.*', book: post) %>
      <% end %>

      <article class="text">
        <div class="e-summary">
          <%= get_post_start(post) %>
        </div>
          <div class="pure-g post-footer">
          <div class = pure-u-1-2>
              <a class='read-more' href='<%= post.path %>'>
                <% if has_more?(post) %>
                  Continue reading &rsaquo;
                <% end %>
              </a>
          </div>
        </div>
        <div class="post-tags">
          <% if post[:tags] && show_tags %>
            <div class="tags">
            <% post[:tags].each.with_index do |tag, i| %>
              <a class="pure-button button-xsmall tag-button p-category" href="/tags/<%= tag %>">
                <%= tag.downcase %> <span class="tag-count"><%= n_posts_in_tag(tag) %></span>
              </a>
            <% end %>
            </div>
          <% end %>
        </div>
      </article>
    </div>
  <% end %>
</div>
